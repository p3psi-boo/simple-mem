# ============================================================
# simple-mem Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# ── Central Hub Server (simple-mem-hub) ──
SIMPLE_MEM_HOST=0.0.0.0
SIMPLE_MEM_PORT=8765
SIMPLE_MEM_DB_PATH=~/.simple-mem/simple-mem.db
SIMPLE_MEM_API_KEY=your-secret-api-key
SIMPLE_MEM_EXTRACT_INTERVAL=60

# ── LLM for Memory Extraction & Conflict Reconciliation (OpenAI-compatible) ──
SIMPLE_MEM_LLM_BASE_URL=https://api.openai.com/v1
SIMPLE_MEM_LLM_API_KEY=sk-your-llm-api-key
SIMPLE_MEM_LLM_MODEL=gpt-4o-mini
SIMPLE_MEM_HEURISTIC_EXTRACT=true

# ── Embedding Model for Hybrid Search (OpenAI-compatible /embeddings) ──
# Defaults to SIMPLE_MEM_LLM_BASE_URL and SIMPLE_MEM_LLM_API_KEY when omitted.
SIMPLE_MEM_EMBED_BASE_URL=https://api.openai.com/v1
SIMPLE_MEM_EMBED_API_KEY=sk-your-embed-api-key
SIMPLE_MEM_EMBED_MODEL=text-embedding-3-small

# ── Edge Client (simple-mem) ──
SIMPLE_MEM_REMOTE_URL=http://127.0.0.1:8765
# SIMPLE_MEM_MACHINE_ID=my-workstation
# SIMPLE_MEM_PROJECT_ID=
